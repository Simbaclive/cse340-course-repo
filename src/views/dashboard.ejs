<%- include('./partials/header') %>
<main class="container">
    <div class="dashboard-card">
        <p>Welcome back, <strong><%= accountData.name %></strong>.</p>
        <p>You are logged in as: <strong><%= accountData.role %></strong></p>
    </div>

    <h2>My Volunteer Projects</h2>
    <% if (volunteeredProjects.length > 0) { %>
        <% volunteeredProjects.forEach(project => { %>
            <div class="project-card">
                <h3><a href="/project/<%= project.project_id %>"><%= project.title %></a></h3>
                <p><strong>Organization:</strong> <%= project.organization_name %></p>
                <p><strong>Date:</strong> <%= project.date.toDateString() %></p>
                <p><strong>Location:</strong> <%= project.location %></p>
                <form action="/unvolunteer/<%= project.project_id %>" method="POST">
                    <button type="submit" class="btn-remove">Remove Myself as Volunteer</button>
                </form>
            </div>
        <% }); %>
    <% } else { %>
        <p>You haven't signed up to volunteer for any projects yet.</p>
    <% } %>
</main>
<%- include('./partials/footer') %>