<%- include('partials/header') %>
<main class="container">
    <% if (typeof errors !== 'undefined' && errors.length > 0) { %>
        <ul class="error-list">
            <% errors.forEach(error => { %>
                <li><%= error.msg %></li>
            <% }) %>
        </ul>
    <% } %>
    <form action="/edit-organization/<%= organization && organization.organization_id ? organization.organization_id : '' %>" method="POST">
        <div class="form-group">
            <label for="name">Organization Name:</label>
            <input type="text" id="name" name="name" required maxlength="150" value="<%= organization && organization.name ? organization.name : '' %>">
        </div>
        <div class="form-group">
            <label for="description">Description:</label>
            <textarea id="description" name="description" required><%= organization && organization.description ? organization.description : '' %></textarea>
        </div>
        <div class="form-group">
            <label for="contact_email">Contact Email:</label>
            <input type="email" id="contact_email" name="contact_email" required maxlength="255" value="<%= organization && organization.contact_email ? organization.contact_email : '' %>">
        </div>
        <div class="form-group">
            <label for="logo_filename">Logo Filename:</label>
            <input type="text" id="logo_filename" name="logo_filename" required maxlength="255" value="<%= organization && organization.logo_filename ? organization.logo_filename : '' %>">
        </div>
        <button type="submit" class="btn">Update Organization</button>
    </form>
    <a href="/organizations">Back to Organizations</a>
</main>
<%- include('partials/footer') %>