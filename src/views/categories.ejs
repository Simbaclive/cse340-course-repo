<%- include('partials/header') %>
<main class="container">

    <% if (locals.accountData && accountData.role === 'Admin') { %>
        <div class="actions" style="margin-bottom: 20px;">
            <a href="/new-category" class="btn">Add New Category</a>
        </div>
    <% } %>

    <% categories.forEach(category => { %>
        <div class="card" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px; padding: 10px; border: 1px solid #ddd;">
            <h3><a href="/category/<%= category.category_id %>"><%= category.category_name %></a></h3>
            <% if (locals.accountData && accountData.role === 'Admin') { %>
                <a href="/edit-category/<%= category.category_id %>" class="btn-edit" style="padding: 5px 10px; background-color: #f0f0f0; text-decoration: none; border-radius: 4px;">Edit</a>
            <% } %>
        </div>
    <% }); %>
</main>
<%- include('partials/footer') %>