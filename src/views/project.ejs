<%- include('partials/header') %>
<main class="container">
    <div class="project-details">
        <p><%= project.description %></p>
        <p><strong>Date:</strong> <%= project.date %></p>
        <p><strong>Location:</strong> <%= project.location %></p>
        <p><strong>Organization:</strong> <a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a></p>

        <div class="category-tags">
            <strong>Categories:</strong>
            <% categories.forEach(category => { %>
                <a href="/category/<%= category.category_id %>" class="tag"><%= category.category_name %></a>
            <% }); %>
        </div>

        <% if (locals.loggedin) { %>
            <div class="volunteer-section">
                <% if (volunteering) { %>
                    <p class="volunteer-status">You are volunteering for this project.</p>
                    <form action="/unvolunteer/<%= project.project_id %>" method="POST">
                        <button type="submit" class="btn-remove">Remove Myself as Volunteer</button>
                    </form>
                <% } else { %>
                    <form action="/volunteer/<%= project.project_id %>" method="POST">
                        <button type="submit" class="btn-submit">Volunteer for this Project</button>
                    </form>
                <% } %>
            </div>
        <% } %>

        <% if (locals.accountData && accountData.role === 'Admin') { %>
            <p><a href="/edit-project/<%= project.project_id %>" class="btn-edit">Edit Project</a></p>
        <% } %>

        <br>
        <a href="/projects">Back to Projects</a>
    </div>
</main>
<%- include('partials/footer') %>