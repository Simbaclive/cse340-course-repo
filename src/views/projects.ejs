<%- include('partials/header') %>

<main>

    <% if (locals.accountData && accountData.role === 'Admin') { %>
        <p><a href="/new-project" class="btn">Add New Project</a></p>
    <% } %>

    <% projects.forEach(project => { %>
        <div class="project-card">
            <h3><a href="/project/<%= project.project_id %>"><%= project.title %></a></h3>
            <p><strong>Organization:</strong> 
                <a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a>
            </p>
            <% if (locals.accountData && accountData.role === 'Admin') { %>
                <a href="/edit-project/<%= project.project_id %>" class="btn-edit">Edit</a>
            <% } %>
        </div>
    <% }); %>
</main>
<%- include('partials/footer') %>